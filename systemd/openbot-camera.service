[Unit]
Description=OpenBot camera (sole camera owner: live MJPEG on :9000, snapshots for the mind)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=/etc/openbot/openbot.env
ExecStart=/usr/bin/python3 -u -m services.camera
Restart=always
# CPU priority: speech-to-text (wake-listen, Nice=0) must win -- face analysis is background work.
Nice=10
RestartSec=5
NotifyAccess=main
# No frames for this long -> health goes stale -> pings stop -> systemd restarts it.
WatchdogSec=90

[Install]
WantedBy=multi-user.target
