# OpenBot settings. setup.sh copies this to openbot.env; edit that copy
# (it's gitignored). systemd/install.sh installs it as /etc/openbot/openbot.env.
# Everything else has a sensible default -- see config.py for the full list.

# The robot: "none" (just a mic + speaker + optional camera) or "picarx".
OPENBOT_BODY=none

# Who it is: a folder in personas/. Its name is also the wake word, so pick a
# plain, common English word the speech model knows.
OPENBOT_PERSONA=rocky
# Long-term memory's project name (set once by setup.sh; every persona shares it).
OPENBOT_MEMORY_PROJECT=openbot

# The brain: any OpenAI-compatible server. Default: Ollama on this machine.
OPENBOT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Must be able to see images (vision) and give JSON output.
OPENBOT_LLM_MODEL=qwen2.5vl:7b

# Speech-to-text: en-us, or en-in (Indian English). Mic name from `arecord -l`.
OPENBOT_STT_LANGUAGE=en-us
OPENBOT_STT_DEVICE="USB PnP Sound Device"
# A whisper.cpp server on the LLM's machine (faster than the Pi): its port, or 0 for none.
OPENBOT_MAC_WHISPER_PORT=0

# Speaker volume control for "louder"/"softer": <ALSA card>:<mixer control>.
# PiCar-X: "2:robot-hat speaker". A USB/3.5mm speaker: try "0:Master" or "0:PCM".
OPENBOT_MIXER=0:Master

# Camera: the Pi camera by default. For a USB webcam instead:
# OPENBOT_CAMERA_CMD="ffmpeg -loglevel error -f v4l2 -input_format mjpeg -video_size 640x480 -framerate 10 -i /dev/video0 -c:v copy -f mjpeg -"

# Quiet hours: no talking or moving on its own between these hours.
OPENBOT_QUIET_START_H=21
OPENBOT_QUIET_END_H=8
